# Keep SDMA firmware built into kernel image, since IMX SDMA is built-in
# and requests firmware very early (before rootfs/boot may be fully available).
CONFIG_EXTRA_FIRMWARE="imx/sdma/sdma-imx7d.bin"
CONFIG_EXTRA_FIRMWARE_DIR="lib/firmware"
CONFIG_ATH10K=m
CONFIG_ATH10K_SDIO=m
CONFIG_EXPERT=y
CONFIG_CFG80211_CERTIFICATION_ONUS=y
CONFIG_CFG80211_REQUIRE_SIGNED_REGDB=n
# Vivante GPU/NPU driver
CONFIG_MXC_GPU_VIV=y


# camera
CONFIG_VIDEO_OV5695=y
