#!/bin/bash

export FBDIR=$(pwd)
export PATH="$FBDIR:$FBDIR/tools:$PATH"
export GIT_SSL_NO_VERIFY=1

if [ `hostname` = fbdebian ] && [ `whoami` = root ]; then
    cp -f /root/.bashrc . && . .bashrc
    git config --global --add safe.directory $FBDIR
fi

[ ! -L tools/bld ] && ln -s flex-builder tools/bld
# Idempotent, set -e-safe 'python' alias: a broken pre-existing symlink
# makes plain 'ln -s' fail with EEXIST and kill set -e sourcers.
if [ -L /usr/bin/python ] && [ ! -e /usr/bin/python ]; then
    sudo rm -f /usr/bin/python
fi
[ -e /usr/bin/python ] || sudo ln -s python3 /usr/bin/python 2>/dev/null || true
true
